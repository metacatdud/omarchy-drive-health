[Unit]
Description=Read SSD SMART health into a local cache

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/lib/omarchy-drive-health/drive_health.py --collect
StateDirectory=omarchy-drive-health
StateDirectoryMode=0755
UMask=0022
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
TimeoutStartSec=5min
